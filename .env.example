# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/reel_analyzer?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/reel_analyzer?retryWrites=true&w=majority
MONGODB_DB=reel_analyzer

# Google AdSense Publisher ID
# Example: NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# PostHog Analytics
# Get your Project API Key from https://posthog.com -> Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to 'true' if you want to enable session recordings (defaults to false for privacy)
NEXT_PUBLIC_POSTHOG_RECORDING=false


