{
  "manifest_version": 3,
  "name": "Reel Analyzer",
  "version": "1.0",
  "description": "Extract Instagram Reels, analyze insights and generate notes with Meta AI, Gemini, or ChatGPT.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "logos/icon-16.png",
    "32": "logos/icon-32.png",
    "48": "logos/icon-48.png",
    "128": "logos/icon-128.png"
  },
  "action": {
    "default_title": "Reel Analyzer",
    "default_icon": {
      "16": "logos/icon-16.png",
      "32": "logos/icon-32.png",
      "48": "logos/icon-48.png",
      "128": "logos/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content_ig.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content_gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content_chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.meta.ai/*", "https://meta.ai/*"],
      "js": ["content_meta.js"],
      "run_at": "document_idle"
    }
  ]
}
